{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/geeko.txt",
    "color": { "1": "#73ba25" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;227;152;39", "title": "38;2;227;152;39" },
    "key": { "width": 5 }
  },
  "modules": [
    "break",
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[90m────────────────────────────" },
    { "type": "os", "key": "\uf314 ", "format": "{pretty-name}" },
    { "type": "kernel", "key": "\uf17c ", "format": "{release}" },
    { "type": "packages", "key": "󰏖 ", "format": "{all}" },
    { "type": "wm", "key": "\uf2d2 ", "format": "{pretty-name}" },
    { "type": "shell", "key": "\uf120 ", "format": "{pretty-name}" },
    { "type": "terminal", "key": "\uf489 ", "format": "{pretty-name}" },
    { "type": "memory", "key": "󰍛 ", "format": "{used} / {total}" },
    { "type": "uptime", "key": "󰅐 " },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
